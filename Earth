  document.getElementById('backBtn').addEventListener('click',()=>crossfadeTo(()=>setView('galaxy')));

  // 시작은 은하 뷰
  setView('galaxy');

  // drag rotate
  let rotY=0,rotX=0.14,auto=true,drag=false,lx=0,ly=0,vY=0,vX=0,downX=0,downY=0,moved=0;
  const cv=renderer.domElement;
  function dn(x,y){drag=true;auto=false;lx=x;ly=y;downX=x;downY=y;moved=0;}
  function mv(x,y){if(!drag)return;moved+=Math.abs(x-lx)+Math.abs(y-ly);vY=(x-lx)*0.006;vX=(y-ly)*0.006;rotY+=vY;rotX=Math.max(-0.9,Math.min(0.9,rotX+vX));lx=x;ly=y;}
  function up(x,y){ if(drag && moved<6) trySelect(x,y); drag=false; }
  cv.addEventListener('mousedown',e=>dn(e.clientX,e.clientY));
  addEventListener('mousemove',e=>mv(e.clientX,e.clientY));
