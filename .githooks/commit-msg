#!/bin/sh
# Terra commit-msg hook — CONTRIBUTING.md 커밋 규칙 강제 (AI 무관: Claude/Gemini/Kiro/손커밋 공통)
# 형식: type(scope): 설명   ·  type: feat|fix|docs|style|refactor|chore  ·  scope 생략 가능
#
# 적용(각자 1회): git config core.hooksPath .githooks
# 우회가 꼭 필요하면: git commit --no-verify

msg_file="$1"

# 주석/빈 줄 제외한 첫 줄 = 제목
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1)

# merge / revert 커밋은 통과
case "$subject" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

# 형식 검증: type(scope): 설명
if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|chore)(\([a-z0-9-]+\))?: .+'; then
  echo "✗ 커밋 메시지 형식 오류:" >&2
  echo "    \"$subject\"" >&2
  echo "" >&2
  echo "  형식: type(scope): 설명" >&2
  echo "  type: feat | fix | docs | style | refactor | chore" >&2
  echo "  예시: feat(be): 계산엔진 배출량 산출 API 추가" >&2
  echo "        fix(ai): fix missing quantity in extraction" >&2
  echo "  (자세히: CONTRIBUTING.md)" >&2
  exit 1
fi

# 제목 끝 마침표 금지
case "$subject" in
  *.) echo "✗ 제목 끝에 마침표(.)는 쓰지 않습니다: \"$subject\"" >&2; exit 1 ;;
esac

# 길이 경고(50자 권장) — 차단하지 않고 알림만
len=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$len" -gt 50 ]; then
  echo "⚠ 제목이 ${len}자입니다 (권장 50자 이내). 통과는 시킵니다." >&2
fi

exit 0
