      box.setFromObject(m); box.getCenter(c); box.getSize(s);
      m.position.sub(c);
      const rad=Math.max(s.x,s.y,s.z)*0.5||0.2, d=rad*3.2;
      cam.position.set(d*0.5,d*0.45,d); cam.lookAt(0,0,0);
      cam.near=Math.max(0.01,d*0.05); cam.far=d*12; cam.updateProjectionMatrix();
      r2.render(sc,cam);
