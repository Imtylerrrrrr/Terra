  function makeMiniEarth(score, detail){
    const g=new THREE.IcosahedronGeometry(R, detail).toNonIndexed();
    const p=g.attributes.position, V=p.count, colors=new Float32Array(V*3);
    const nd=new THREE.Vector3();
    const t=(score/100)*3, si=Math.min(Math.floor(t),2), sf=t-si;
    for(let i=0;i<V;i++){
      nd.set(p.getX(i),p.getY(i),p.getZ(i)).normalize();
      const c=classify(nd), b=c.b, a=TAB[b][si], bb=TAB[b][si+1];
      colors[i*3]=a.r+(bb.r-a.r)*sf; colors[i*3+1]=a.g+(bb.g-a.g)*sf; colors[i*3+2]=a.b+(bb.b-a.b)*sf;
      const lift=liftAt(c.h, nd);
      p.setXYZ(i, p.getX(i)*lift, p.getY(i)*lift, p.getZ(i)*lift);
