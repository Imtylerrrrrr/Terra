  // 각 항목 3D 모델을 썸네일(PNG)로 1회 렌더
  (function buildDexThumbs(){
    const r2=new THREE.WebGLRenderer({antialias:true,alpha:true,preserveDrawingBuffer:true});
    r2.setSize(140,140); r2.setPixelRatio(1.5); r2.outputEncoding=THREE.sRGBEncoding;
    const sc=new THREE.Scene();
