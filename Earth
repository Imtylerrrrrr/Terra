  })();

  // 학과 행성들로 이루어진 나선 은하 1개
  function makeGalaxy(ci){
    const c=CAMPUSES[ci], g=new THREE.Group();
    const N=240, pos=new Float32Array(N*3), col=new Float32Array(N*3), arms=3;
    const tmp=new THREE.Color();
    for(let i=0;i<N;i++){
      const t=Math.pow(Math.random(),0.6), r=0.25+t*1.7;
      const arm=Math.floor(Math.random()*arms);
      const ang=arm*(6.283/arms)+t*3.0+(Math.random()-0.5)*0.5;
      pos[i*3]=Math.cos(ang)*r; pos[i*3+1]=(Math.random()-0.5)*0.14*(1-t); pos[i*3+2]=Math.sin(ang)*r;
      tmp.setHSL(0.58-0.12*(1-t), 0.7, 0.45+0.4*(1-t));   // 중심 따뜻 → 외곽 푸름
      col[i*3]=tmp.r; col[i*3+1]=tmp.g; col[i*3+2]=tmp.b;
    }
    const geo=new THREE.BufferGeometry();
    geo.setAttribute('position',new THREE.BufferAttribute(pos,3));
    geo.setAttribute('color',new THREE.BufferAttribute(col,3));
    const pts=new THREE.Points(geo,new THREE.PointsMaterial({size:0.055,vertexColors:true,transparent:true,opacity:0.92,depthWrite:false}));
    g.add(pts);
    const core=new THREE.Sprite(new THREE.SpriteMaterial({map:coreTex,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false}));
    core.scale.set(1.1,1.1,1); g.add(core);
    const hit=new THREE.Mesh(new THREE.SphereGeometry(1.6,8,8), new THREE.MeshBasicMaterial({visible:false}));
    hit.userData={idx:ci}; g.add(hit); galaxyHits.push(hit);
    const lab=makeLabel(c.name); lab.position.set(0,1.9,0); g.add(lab);
    g.rotation.x=-0.6; g.userData={pts, spin:0.0016+Math.random()*0.002};
    return g;
  }
  function galaxySlots(n){
    const out=[], gold=2.39996323;
    for(let k=0;k<n;k++){
      const a=k*gold, r=1.2+(k%3)*1.3;
      out.push(new THREE.Vector3(Math.cos(a)*(r+2.2), Math.sin(a)*(r*0.55+0.7), -2-(k%4)*1.4));
    }
    return out;
  }
  (function buildGalaxies(){
    const slots=galaxySlots(CAMPUSES.length);
    CAMPUSES.forEach((c,i)=>{ const g=makeGalaxy(i); g.position.copy(slots[i]); GALAXIES.add(g); galaxies.push(g); });
  })();

  // 뷰 전환
