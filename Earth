  }
  const bones=[];
  spots(c=>c.b===0||c.b===1, 8).forEach(s=>{
    const d=s.dir;
    const bn=makeBone(); bn.scale.setScalar(0.0001);
    const holder=new THREE.Group(); holder.position.copy(d).multiplyScalar(R*1.015);
    holder.quaternion.setFromUnitVectors(UP, d.clone().normalize()); holder.add(bn);
    const axis=new THREE.Vector3().crossVectors(d,new THREE.Vector3(rnd()-.5,rnd()-.5,rnd()-.5)).normalize();
    const pivot=new THREE.Group(); pivot.add(holder); earthGroup.add(pivot);
    bones.push({pivot,bn,holder,axis,speed:0.0006+rnd()*0.0008,base:2.6+rnd()*1.0,ph:rnd()*6.28,fade:1,lo:0,hi:42});
  });

  // 고래 — 디테일 업, 푸른 바다(정상~청정)에서 헤엄
  function makeWhale(){
    const g=new THREE.Group();
    const top=M(0x2e4e66,1), bot=M(0xb0bcc4,1), dk=M(0x213848,1);
    const body=new THREE.Mesh(new THREE.SphereGeometry(0.05,16,11),top);body.scale.set(2.7,1,1.06);
    const belly=new THREE.Mesh(new THREE.SphereGeometry(0.047,16,11),bot);belly.scale.set(2.55,0.72,0.98);belly.position.y=-0.014;
    const head=new THREE.Mesh(new THREE.SphereGeometry(0.042,13,9),top);head.position.x=0.095;head.scale.set(1.15,0.96,1.0);
    // 꼬리자루 + 꼬리지느러미(두 갈래)
    const ped=new THREE.Mesh(new THREE.CylinderGeometry(0.024,0.012,0.07,8),top);ped.rotation.z=Math.PI/2;ped.position.x=-0.125;
    const fluke=new THREE.Group();fluke.position.x=-0.165;
    const fl1=new THREE.Mesh(new THREE.ConeGeometry(0.028,0.055,4),top);fl1.rotation.z=Math.PI/2;fl1.scale.set(1,0.22,1.7);fl1.position.z=0.028;fl1.rotation.x=0.45;
    const fl2=fl1.clone();fl2.position.z=-0.028;fl2.rotation.x=-0.45;fluke.add(fl1,fl2);
    // 가슴지느러미 한 쌍
    const pec=new THREE.Mesh(new THREE.ConeGeometry(0.02,0.055,3),top);pec.position.set(0.02,-0.022,0.052);pec.rotation.set(0.6,0,0.85);pec.scale.set(1,0.28,1);
    const pec2=pec.clone();pec2.position.z=-0.052;pec2.rotation.set(-0.6,0,0.85);
    // 등지느러미
    const dorsal=new THREE.Mesh(new THREE.ConeGeometry(0.016,0.034,3),top);dorsal.position.set(-0.04,0.045,0);dorsal.rotation.x=0.1;
    // 눈 + 입선
    const eye=new THREE.Mesh(new THREE.SphereGeometry(0.007,6,5),dk);eye.position.set(0.11,0.006,0.04);
    const eye2=eye.clone();eye2.position.z=-0.04;
    const mouth=new THREE.Mesh(new THREE.BoxGeometry(0.05,0.003,0.002),dk);mouth.position.set(0.105,-0.012,0.03);mouth.rotation.y=0.3;
    const mouth2=mouth.clone();mouth2.position.z=-0.03;mouth2.rotation.y=-0.3;
    // 분수공
    const blow=new THREE.Mesh(new THREE.CylinderGeometry(0.006,0.006,0.006,6),dk);blow.position.set(0.06,0.05,0);
    g.add(body,belly,head,ped,fluke,pec,pec2,dorsal,eye,eye2,mouth,mouth2,blow);
    g._fluke=fluke;
    return g;
  }
  const whales=[];
  spots(c=>c.b===0, 6).forEach(s=>{
    const d=s.dir;
    const wh=makeWhale(); wh.scale.setScalar(0.0001);
    const holder=new THREE.Group(); holder.position.copy(d).multiplyScalar(R*1.01);
    holder.quaternion.setFromUnitVectors(UP, d.clone().normalize()); holder.add(wh);
    const axis=new THREE.Vector3().crossVectors(d,new THREE.Vector3(rnd()-.5,rnd()-.5,rnd()-.5)).normalize();
    const pivot=new THREE.Group(); pivot.add(holder); earthGroup.add(pivot);
    whales.push({pivot,wh,holder,axis,speed:0.0008+rnd()*0.0009,base:0.95+rnd()*0.4,ph:rnd()*6.28,fade:1,lo:60,hi:100});
  });

  // 구름 (항상, 띄움)
  const cloudGroup=new THREE.Group(); earthGroup.add(cloudGroup);
  for(let i=0;i<22;i++){
    const th=rnd()*6.283, ph=Math.acos(2*rnd()-1);
    const d=new THREE.Vector3(Math.sin(ph)*Math.cos(th),Math.cos(ph),Math.sin(ph)*Math.sin(th));
    const cl=makeCloud();cl.scale.setScalar(0.8+rnd()*0.7);
    cl.position.copy(d.clone().multiplyScalar(R*1.22));cl.quaternion.setFromUnitVectors(UP,d.clone().normalize());
    cloudGroup.add(cl);
  }

  // 위성 (궤도) + 달
  const sat=new THREE.Group();
  const sbody=new THREE.Mesh(new THREE.BoxGeometry(0.1,0.08,0.08),M(0xc9cdd2,0.4));
  const sp1=new THREE.Mesh(new THREE.BoxGeometry(0.16,0.001,0.06),M(0x244a8a,0.3));sp1.position.x=0.15;
  const sp2=sp1.clone();sp2.position.x=-0.15; sat.add(sbody,sp1,sp2);
  const satOrbit=new THREE.Group();satOrbit.add(sat);sat.position.set(3.0,1.2,0);scene.add(satOrbit);
  satOrbit.rotation.z=0.4;
  const moon=new THREE.Mesh(new THREE.IcosahedronGeometry(0.32,1),M(0xd7d9de,1));moon.position.set(5,3.2,-3);scene.add(moon);

  // ============================================================================
  //  prop fade
  // ============================================================================
  function ramp(v,lo,hi){const fade=13;if(v<lo-fade||v>hi+fade)return 0;let f=1;
    if(v<lo)f=(v-(lo-fade))/fade;else if(v>hi)f=((hi+fade)-v)/fade;return Math.max(0,Math.min(1,f));}
  function updateProps(v){
    for(const p of props){const k=ramp(v,p.lo,p.hi);p.mesh.visible=k>0.02;
      if(p.mesh.visible)p.mesh.scale.setScalar(p.base*k);}
  }

  // ============================================================================
  //  UI
  // ============================================================================
  const scoreEl=document.getElementById('score'), statusEl=document.getElementById('status');
  function status(v){
    let l,c;
    if(v<25){l='멸망 위기';c='#c46a4a';}
    else if(v<50){l='사막화';c='#d9b35e';}
    else if(v<72){l='회복 중';c='#7fc7d8';}
    else if(v<90){l='건강';c='#6fce8c';}
    else{l='청정 지구';c='#4fe08a';}
    scoreEl.textContent=Math.round(v);scoreEl.style.color=c;statusEl.textContent=l;statusEl.style.color=c;
    const top=new THREE.Color().lerpColors(new THREE.Color(0x241a12),new THREE.Color(0x16202c),Math.min(v/66,1));
    document.body.style.background=`radial-gradient(120% 120% at 50% 16%, #${top.getHexString()} 0%, #0a0f15 55%, #05080b 100%)`;
  }

  let current=62, target=62;
  const _cloudGrey=new THREE.Color(0x5e5e66), _cloudWhite=new THREE.Color(0xffffff);
  function apply(v){
    paintEarth(v); updateProps(v); status(v);
    // 구름: 오염(0)일수록 회색, 청정(100)일수록 흰색
    cloudMat.color.copy(_cloudGrey).lerp(_cloudWhite, Math.min(v/85,1));
  }
  apply(current);
  const slider=document.getElementById('slider');
  slider.addEventListener('input',e=>target=+e.target.value);

  // drag rotate
  let rotY=0,rotX=0.14,auto=true,drag=false,lx=0,ly=0,vY=0,vX=0;
  const cv=renderer.domElement;
  function dn(x,y){drag=true;auto=false;lx=x;ly=y;}
  function mv(x,y){if(!drag)return;vY=(x-lx)*0.006;vX=(y-ly)*0.006;rotY+=vY;rotX=Math.max(-0.9,Math.min(0.9,rotX+vX));lx=x;ly=y;}
  function up(){drag=false;}
  cv.addEventListener('mousedown',e=>dn(e.clientX,e.clientY));
  addEventListener('mousemove',e=>mv(e.clientX,e.clientY));
  addEventListener('mouseup',up);
  // 휠 줌
  cv.addEventListener('wheel',e=>{ e.preventDefault();
    camDist=Math.max(camMin,Math.min(camMax,camDist+e.deltaY*0.012)); updateCam();
  },{passive:false});
  // 터치: 1손가락 회전 / 2손가락 핀치 줌
  let pinch=0;
  cv.addEventListener('touchstart',e=>{
    if(e.touches.length>=2){ const dx=e.touches[0].clientX-e.touches[1].clientX, dy=e.touches[0].clientY-e.touches[1].clientY; pinch=Math.hypot(dx,dy); }
    else dn(e.touches[0].clientX,e.touches[0].clientY);
  },{passive:true});
  addEventListener('touchmove',e=>{
    if(e.touches.length>=2){ const dx=e.touches[0].clientX-e.touches[1].clientX, dy=e.touches[0].clientY-e.touches[1].clientY; const d=Math.hypot(dx,dy);
      camDist=Math.max(camMin,Math.min(camMax,camDist+(pinch-d)*0.02)); pinch=d; updateCam(); }
    else if(drag) mv(e.touches[0].clientX,e.touches[0].clientY);
  },{passive:true});
  addEventListener('touchend',up);

  // loop
  let smk=0;
  function animate(){
    requestAnimationFrame(animate);
    if(Math.abs(target-current)>0.05){current+=(target-current)*0.12;apply(current);}
    if(auto)rotY+=0.0015; else { if(!drag){vY*=0.93;vX*=0.93;rotY+=vY;rotX=Math.max(-0.9,Math.min(0.9,rotX+vX));} }
    earthGroup.rotation.y=rotY;earthGroup.rotation.x=rotX;
    cloudGroup.rotation.y+=0.0006;
    smk+=0.016;
    for(const p of props){
      if(!p.mesh.visible)continue;
      if(p.type==='turbine'&&p.mesh._hub)p.mesh._hub.rotation.z+=0.035;
      if(p.type==='windmill'&&p.mesh._sail)p.mesh._sail.rotation.z+=0.016;
      if(p.type==='factory'&&p.mesh._smoke)p.mesh._smoke.forEach((s,i)=>s.position.y=s._b+Math.sin(smk+i)*0.012);
      if(p.type==='nuke'&&p.mesh._steam)p.mesh._steam.forEach((s,i)=>{s.position.y=s._b+Math.sin(smk*0.7+i)*0.02;s.rotation.y+=0.006;});
    }
    satOrbit.rotation.y+=0.002; moon.rotation.y+=0.0016;
    // 회전초 — 육지에서만, 바다로 가면 작아지며 사라짐
    for(const t of tumbleweeds){
      _q.setFromAxisAngle(t.axis,t.speed); t.pivot.quaternion.premultiply(_q);
      const k=ramp(current,t.lo,t.hi);
      _cur.copy(t.tw.position).normalize().applyQuaternion(t.pivot.quaternion);
      t.fade += ((isLand(_cur)?1:0) - t.fade)*0.09;
      const s=t.base*k*t.fade; t.tw.visible=s>0.003;
      if(t.tw.visible){ t.tw.scale.setScalar(s); t.tw.rotation.x+=0.1; }
    }
    // 뼈다귀 — 바다에서만, 대륙으로 가면 작아지며 사라짐
    for(const b of bones){
      _q.setFromAxisAngle(b.axis,b.speed); b.pivot.quaternion.premultiply(_q);
      const k=ramp(current,b.lo,b.hi);
      _cur.copy(b.holder.position).normalize().applyQuaternion(b.pivot.quaternion);
      b.fade += ((isLand(_cur)?0:1) - b.fade)*0.09;
      const s=b.base*k*b.fade; b.bn.visible=s>0.003;
      if(b.bn.visible){ b.bn.scale.setScalar(s);
        b.ph+=0.022; b.bn.position.y=Math.sin(b.ph)*0.02; b.bn.rotation.y+=0.005; b.bn.rotation.z=Math.sin(b.ph*0.7)*0.2; }
    }
    // 고래 — 바다에서만, 대륙으로 가면 작아지며 사라짐
    for(const wh of whales){
      _q.setFromAxisAngle(wh.axis,wh.speed); wh.pivot.quaternion.premultiply(_q);
      const k=ramp(current,wh.lo,wh.hi);
      _cur.copy(wh.holder.position).normalize().applyQuaternion(wh.pivot.quaternion);
      wh.fade += ((isLand(_cur)?0:1) - wh.fade)*0.09;
      const s=wh.base*k*wh.fade; wh.wh.visible=s>0.003;
      if(wh.wh.visible){ wh.wh.scale.setScalar(s);
        wh.ph+=0.028; wh.wh.position.y=Math.sin(wh.ph)*0.012; wh.wh.rotation.z=Math.sin(wh.ph)*0.1;
        if(wh.wh._fluke)wh.wh._fluke.rotation.y=Math.sin(wh.ph*2)*0.4; }
    }
    renderer.render(scene,camera);
  }
  animate();
  addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});

  // 로더 숨김
  setTimeout(()=>document.getElementById('loader').classList.add('hide'),350);
  </script>
</body>
</html>
