  // 은하 코어 글로우 스프라이트 텍스처 (1회 생성)
  const coreTex=(function(){
    const cv=document.createElement('canvas'); cv.width=cv.height=128;
    const x=cv.getContext('2d'); const g=x.createRadialGradient(64,64,2,64,64,64);
    g.addColorStop(0,'rgba(255,246,214,1)'); g.addColorStop(0.3,'rgba(255,210,140,0.7)');
    g.addColorStop(1,'rgba(255,180,90,0)'); x.fillStyle=g; x.fillRect(0,0,128,128);
