<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Terra · Living Earth</title>
<style>
  :root{ --ink:#eaf0f4; --muted:#8b97a3; --panel:rgba(12,18,26,.74); --line:rgba(255,255,255,.10); }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:radial-gradient(120% 120% at 50% 16%, #16202c 0%, #0a0f15 55%, #05080b 100%);
    color:var(--ink);
    font-family:"Segoe UI",-apple-system,"Helvetica Neue",Arial,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;
    overflow:hidden;-webkit-tap-highlight-color:transparent;
  }
  #stage{position:fixed;inset:0}
  canvas{display:block}
  #loader{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;
    flex-direction:column;gap:14px;z-index:20;background:#070b10;transition:opacity .6s}
  #loader.hide{opacity:0;pointer-events:none}
  .spin{width:42px;height:42px;border-radius:50%;border:3px solid rgba(255,255,255,.15);
    border-top-color:#5fd38a;animation:r 1s linear infinite}
  @keyframes r{to{transform:rotate(360deg)}}
  #loader p{font-size:12px;letter-spacing:.18em;color:var(--muted);text-transform:uppercase}

  .topbar{position:fixed;top:0;left:0;right:0;display:flex;align-items:baseline;gap:14px;
    padding:22px 26px;pointer-events:none;z-index:5}
  .brand{font-weight:800;letter-spacing:.18em;font-size:14px;text-transform:uppercase}
  .brand b{color:#5fd38a}
  .tag{font-size:12px;color:var(--muted);letter-spacing:.04em}

  .menu{position:fixed;top:80px;left:26px;display:flex;flex-direction:column;gap:8px;z-index:5;pointer-events:auto}
  .menu-item{font-size:18px;font-weight:700;color:var(--ink);letter-spacing:.02em;cursor:pointer;
    transition:all .2s ease;user-select:none}
  .menu-item:hover{transform:scale(1.15);color:#5fd38a;font-weight:800}

  .readout{position:fixed;top:0;left:0;right:0;display:flex;flex-direction:column;
    align-items:center;margin-top:60px;pointer-events:none;z-index:4}
  .score{font-size:88px;font-weight:800;line-height:.9;letter-spacing:-.02em;
    font-variant-numeric:tabular-nums;text-shadow:0 6px 30px rgba(0,0,0,.55);transition:color .25s}
  .status{margin-top:6px;font-size:13px;letter-spacing:.32em;text-transform:uppercase;
    font-weight:700;transition:color .25s}
  .dept{font-size:15px;letter-spacing:.22em;font-weight:700;color:#cdd6dd;margin-bottom:6px;
    text-shadow:0 2px 12px rgba(0,0,0,.6)}

  .controls{position:fixed;left:50%;bottom:30px;transform:translateX(-50%);width:min(680px,92vw);
    background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px 22px 20px;
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    box-shadow:0 20px 60px rgba(0,0,0,.45);z-index:6}
  .ends{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--muted);margin-bottom:12px}
  .ends .l{color:#c98a5a}.ends .r{color:#6fce8c}
  .slider{-webkit-appearance:none;appearance:none;width:100%;height:10px;border-radius:999px;outline:none;
    background:linear-gradient(90deg,#473826 0%,#6b5638 13%,#cdb46a 33%,#2f7fb8 50%,#4f9e54 66%,#2f9c4a 84%,#1f8f55 100%);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);cursor:pointer}
  .slider::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:26px;height:26px;
    border-radius:50%;background:#fff;border:3px solid #0a0f15;box-shadow:0 3px 12px rgba(0,0,0,.5);cursor:grab}
  .slider::-webkit-slider-thumb:active{cursor:grabbing}
  .slider::-moz-range-thumb{width:24px;height:24px;border-radius:50%;background:#fff;border:3px solid #0a0f15;cursor:grab}
  .ticks{display:flex;justify-content:space-between;margin-top:10px;font-size:10.5px;color:var(--muted);letter-spacing:.06em}
  .ticks span{flex:1}.ticks span:nth-child(2),.ticks span:nth-child(3){text-align:center}.ticks span:last-child{text-align:right}
  .hint{position:fixed;left:50%;bottom:8px;transform:translateX(-50%);font-size:10.5px;
    color:rgba(255,255,255,.32);letter-spacing:.06em;z-index:6;pointer-events:none}

  .addbox{position:fixed;top:172px;left:26px;z-index:6;width:208px;display:flex;flex-direction:column;gap:10px}
  .add-toggle{padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--panel);
    color:var(--ink);font-weight:700;font-size:13px;cursor:pointer;backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);text-align:left}
  .add-toggle:hover{color:#5fd38a}
  .add-form{display:none;flex-direction:column;gap:8px;padding:14px;background:var(--panel);
    border:1px solid var(--line);border-radius:14px;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
  .add-form.show{display:flex}
  .add-form input{padding:8px 10px;border-radius:8px;border:1px solid #2a2f4a;background:#141831;
    color:var(--ink);font-size:13px;width:100%}
  .add-form input::placeholder{color:#6b7280}
  .add-form #f-add{padding:9px;border:none;border-radius:8px;background:#5fd38a;color:#06210f;
    font-weight:800;font-size:13px;cursor:pointer}
  .add-form #f-add:hover{background:#74e09c}
  .add-msg{font-size:11px;color:#e8a33a;min-height:13px;letter-spacing:.02em}

  .dex-toggle{position:fixed;top:22px;right:26px;z-index:7;padding:9px 14px;border:1px solid var(--line);
    border-radius:10px;background:var(--panel);color:var(--ink);font-weight:700;font-size:13px;cursor:pointer;
    backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
  .dex-toggle:hover{color:#5fd38a}
  .dex-panel{position:fixed;top:0;right:0;height:100%;width:340px;max-width:86vw;z-index:8;transform:translateX(100%);
    transition:transform .35s ease;background:rgba(10,15,21,.93);border-left:1px solid var(--line);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);display:flex;flex-direction:column;padding:20px}
  .dex-panel.show{transform:translateX(0)}
  .dex-head{display:flex;justify-content:space-between;align-items:center;font-weight:800;font-size:15px;margin-bottom:14px}
  .dex-close{background:none;border:none;color:var(--muted);font-size:24px;line-height:1;cursor:pointer}
  .dex-close:hover{color:var(--ink)}
  .dex-demo{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
  .dex-demo label{font-size:12px;color:var(--muted)}
  .dex-demo label b{color:#5fd38a;font-size:14px}
  .dex-hint{font-size:10.5px;color:rgba(255,255,255,.35)}
  .dex-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;overflow-y:auto;padding-right:4px}
  .dex-card{background:#141831;border:1px solid #232844;border-radius:12px;padding:10px;text-align:center;transition:all .3s}
  .dex-thumb{position:relative;width:100%;aspect-ratio:1;border-radius:8px;overflow:hidden;
    background:radial-gradient(circle at 50% 38%,#1c2440,#0c1020)}
  .dex-thumb img{width:100%;height:100%;object-fit:contain;transition:filter .3s,opacity .3s}
  .dex-lock{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:26px}
  .dex-card.locked .dex-thumb img{filter:grayscale(1) brightness(.35);opacity:.6}
  .dex-card:not(.locked) .dex-lock{display:none}
  .dex-name{margin-top:8px;font-size:13px;font-weight:700}
  .dex-card.locked .dex-name{color:var(--muted)}
  .dex-kg{font-size:11px;color:#5fd38a;margin-top:2px}
  .dex-card.locked .dex-kg{color:var(--muted)}
  .dex-card.justUnlocked{border-color:#5fd38a;box-shadow:0 0 18px rgba(95,211,138,.55);transform:scale(1.05)}

  /* 화면 전환 페이드 */
  #fadeover{position:fixed;inset:0;background:#05080b;opacity:0;pointer-events:none;
    transition:opacity .38s ease;z-index:30}
  /* 은하 뷰 UI */
  .galaxy-title{position:fixed;top:0;left:0;right:0;text-align:center;margin-top:64px;
    font-size:40px;font-weight:800;letter-spacing:.04em;z-index:5;pointer-events:none;
    text-shadow:0 6px 30px rgba(0,0,0,.55)}
  .galaxy-sub{position:fixed;top:0;left:0;right:0;text-align:center;margin-top:118px;
    font-size:13px;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);z-index:5;pointer-events:none}
  .back-btn{position:fixed;top:22px;left:26px;z-index:7;padding:9px 14px;border:1px solid var(--line);
    border-radius:10px;background:var(--panel);color:var(--ink);font-weight:700;font-size:13px;cursor:pointer;
    backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
  .back-btn:hover{color:#5fd38a}
  /* 뷰별 표시 토글 */
  body[data-view="galaxy"] .controls,
  body[data-view="galaxy"] .readout,
  body[data-view="galaxy"] .addbox,
  body[data-view="galaxy"] .dex-toggle,
  body[data-view="galaxy"] .dex-panel,
  body[data-view="galaxy"] .menu,
  body[data-view="galaxy"] .hint,
  body[data-view="galaxy"] .back-btn{display:none}
  body[data-view="planets"] .galaxy-ui{display:none}
  @media (max-width:520px){.score{font-size:62px}.readout{margin-top:52px}.topbar{padding:16px 18px}}
</style>
</head>
<body>
  <div id="loader"><div class="spin"></div><p>테라가 지구 설계중…</p></div>
  <div id="stage"></div>
  <div id="fadeover"></div>

  <button class="back-btn" id="backBtn">← 캠퍼스 은하</button>
  <div class="galaxy-title galaxy-ui">캠퍼스 은하</div>
  <div class="galaxy-sub galaxy-ui">은하를 클릭해 캠퍼스로 진입</div>

  <div class="topbar"><span class="brand">TERRA<b>.</b></span>
    <span class="tag">탄소 중립 지구 · Living Low-Poly Earth</span></div>

  <div class="menu">
    <div class="menu-item">- 캠퍼스</div>
    <div class="menu-item">- 학과</div>
    <div class="menu-item">- 나</div>
  </div>

  <div class="addbox">
    <button class="add-toggle" id="addToggle">+ 학과 추가</button>
    <div class="add-form" id="addForm">
      <input id="f-name" type="text" placeholder="학과명" maxlength="14" aria-label="학과명">
      <input id="f-students" type="number" min="1" placeholder="전체 학과생 수" aria-label="전체 학과생 수">
      <input id="f-part" type="number" min="0" placeholder="참여 학과생 수" aria-label="참여 학과생 수">
      <button id="f-add">행성 추가</button>
      <div class="add-msg" id="addMsg"></div>
    </div>
  </div>

  <div class="readout"><div class="dept" id="dept">컴퓨터공학과</div><div class="score" id="score">62</div><div class="status" id="status">회복 중</div></div>

  <div class="controls">
    <div class="ends"><span class="l">◀ 황폐</span><span class="r">풍요 ▶</span></div>
    <input id="slider" class="slider" type="range" min="0" max="100" value="62" step="1">
    <div class="ticks"><span>0 · 멸망</span><span>33 · 사막화</span><span>66 · 정상</span><span>100 · 청정</span></div>
  </div>
  <button class="dex-toggle" id="dexToggle">📖 도감</button>
  <div class="dex-panel" id="dexPanel">
    <div class="dex-head"><span>📖 도감 — 탄소 절감 수집</span><button class="dex-close" id="dexClose">×</button></div>
    <div class="dex-demo">
      <label>누적 절감량 <b id="dexKgVal">0.0</b> kg</label>
      <input id="dexKg" class="slider" type="range" min="0" max="50" step="0.1" value="0">
      <div class="dex-hint">마일스톤마다 1종 해금 · 0.5·2·5·10kg 확정(이후 임시)</div>
    </div>
    <div class="dex-grid" id="dexGrid"></div>
  </div>

  <div class="hint">드래그로 회전 · 휠/핀치로 확대·축소 · 주변 행성 클릭으로 학과 전환</div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
  // ============================================================================
  //  TERRA — Living Low-Poly Earth  (high-detail rebuild)
  //  0 멸망 · 33 사막화 · 66 정상 · 100 청정/풍요
  // ============================================================================
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(38, innerWidth/innerHeight, 0.1, 200);
  let camDist = 9.8; const camMin=5.5, camMax=20;
  function updateCam(){ camera.position.set(0, camDist*0.07, camDist); camera.lookAt(0,0,0); }
  updateCam();
  const renderer = new THREE.WebGLRenderer({antialias:true, alpha:true});
  renderer.setSize(innerWidth, innerHeight);
  renderer.setPixelRatio(Math.min(devicePixelRatio, 1.75));
  renderer.outputEncoding = THREE.sRGBEncoding;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 0.8;
  document.getElementById('stage').appendChild(renderer.domElement);

  // ---- lighting ----
  const sun = new THREE.DirectionalLight(0xffeede, 1.05); sun.position.set(5,4,6); scene.add(sun);
  const rim = new THREE.DirectionalLight(0x7898c8, 0.25); rim.position.set(-6,-1,-5); scene.add(rim);
  scene.add(new THREE.AmbientLight(0xffffff, 0.26));
  const fill = new THREE.HemisphereLight(0x8898a8, 0x18120a, 0.12); scene.add(fill);

  // ---- starfield ----
  (function(){
    const g=new THREE.BufferGeometry(), n=700, p=new Float32Array(n*3), s=new Float32Array(n);
    for(let i=0;i<n;i++){const r=45+Math.random()*30,th=Math.random()*6.283,ph=Math.acos(2*Math.random()-1);
      p[i*3]=r*Math.sin(ph)*Math.cos(th);p[i*3+1]=r*Math.sin(ph)*Math.sin(th);p[i*3+2]=r*Math.cos(ph);s[i]=Math.random();}
    g.setAttribute('position',new THREE.BufferAttribute(p,3));
    scene.add(new THREE.Points(g,new THREE.PointsMaterial({color:0xffffff,size:0.14,transparent:true,opacity:.75})));
  })();

  // ============================================================================
  //  Procedural terrain  (blob continents + fbm coastline)
  // ============================================================================
  const R = 2.0;
  const earthGroup = new THREE.Group(); scene.add(earthGroup);

  // seeded RNG
  let _s = 7766554;
  const rnd = () => (_s = (_s*16807)%2147483647)/2147483647;

  // value noise + fbm
  function hashL(ix,iy,iz){ let n=ix*374761393+iy*668265263+iz*2147483647; n=(n^(n>>13))*1274126177; return ((n^(n>>16))>>>0)/4294967295; }
  function vnoise(x,y,z){
    const ix=Math.floor(x),iy=Math.floor(y),iz=Math.floor(z);
    const fx=x-ix,fy=y-iy,fz=z-iz;
    const u=fx*fx*(3-2*fx),v=fy*fy*(3-2*fy),w=fz*fz*(3-2*fz);
    const c=(a,b,c2)=>hashL(ix+a,iy+b,iz+c2);
    const x00=c(0,0,0)+(c(1,0,0)-c(0,0,0))*u, x10=c(0,1,0)+(c(1,1,0)-c(0,1,0))*u;
    const x01=c(0,0,1)+(c(1,0,1)-c(0,0,1))*u, x11=c(0,1,1)+(c(1,1,1)-c(0,1,1))*u;
    const y0=x00+(x10-x00)*v, y1=x01+(x11-x01)*v;
    return (y0+(y1-y0)*w)*2-1;
  }
  function fbm(x,y,z,oct=5){ let s=0,a=0.5,f=1; for(let o=0;o<oct;o++){s+=a*vnoise(x*f,y*f,z*f);f*=2.03;a*=0.5;} return s; }

  // continent blobs — 작고 분리된 대륙들 (바다 비율 확보)
  const conts=[];
  for(let i=0;i<7;i++){
    const th=rnd()*6.283, ph=Math.acos(2*rnd()-1);
    conts.push({dir:new THREE.Vector3(Math.sin(ph)*Math.cos(th),Math.cos(ph),Math.sin(ph)*Math.sin(th)),
      amp:0.8+rnd()*0.7, spread:0.18+rnd()*0.35});
  }
  const _t=new THREE.Vector3();
  function elevAt(dir){
    let e=0; for(const c of conts){ const d=dir.distanceTo(c.dir); e+=c.amp*Math.exp(-(d*d)/c.spread); }
    e = Math.tanh(e*0.80);                                  // 0~1로 압축
    e += fbm(dir.x*3.2+5,dir.y*3.2,dir.z*3.2-3,5)*0.11;     // 해안선 디테일
    e += fbm(dir.x*7.0,dir.y*7.0+9,dir.z*7.0,3)*0.05;       // 잔주름
    return e;
  }
  const SEA = 0.47;
  // biome: 0 deepOcean,1 shallow,2 beach,3 plain,4 forest,5 highland,6 mountain,7 snow,8 ice
  function classify(dir){
    const e = elevAt(dir);
    const lat = Math.abs(dir.y);
    // ★ 바다 최우선: 어떤 위도에서도 바다는 흰색(극관/설산)이 되지 않음
    if(e < SEA){ const depth=SEA-e; return {b: depth>0.10?0:1, h:-depth, e}; }
    const h = e-SEA;   // 0 ~ ~0.4
    if(lat>0.93) return {b:8,h,e};                    // 극관 (꼭대기만)
    if(lat>0.88 && h<0.12) return {b:7,h,e};
    if(h<0.008) return {b:2,h,e};                     // 해변 (얇게 → 경계 뚜렷)
    if(h<0.15)  return {b:3,h,e};                     // 평지 (넓게)
    if(h<0.27)  return {b:4,h,e};                     // 숲
    if(h<0.34)  return {b:5,h,e};                     // 고지
    if(h<0.40)  return {b:6,h,e};                     // 산
    return {b:7,h,e};                                  // 설산 (극히 드묾)
  }

  // 대학 부지: 큰 평지 한 곳을 정점 빌드 전에 결정
  let univDir=null;
  for(let i=0;i<800 && !univDir;i++){
    const th=rnd()*6.283, ph=Math.acos(2*rnd()-1);
    const d=new THREE.Vector3(Math.sin(ph)*Math.cos(th),Math.cos(ph),Math.sin(ph)*Math.sin(th));
    const c=classify(d);
    if(c.b===3 && c.h>0.02 && c.h<0.09 && Math.abs(d.y)<0.7) univDir=d;   // 일반 평지
  }
  if(!univDir) univDir=new THREE.Vector3(1,0,0).normalize();
  const PLAT_R=0.55, PLAT_H=0.0;  // 고원 효과 제거
  function plateauLift(dir){
    return 0;  // 고원 융기 비활성화
  }
  // 대륙 고도(육지만 솟음) + 대학 고원. place와 정점이 동일 공식을 써 오브젝트가 지표에 정확히 안착
  function liftAt(h,dir){
    let l = h>0 ? 1 + 0.015 + Math.min(h,0.5)*0.08 : 1;
    if(dir && h>0) l += plateauLift(dir);
    return l;
  }

  // geometry
  let geo = new THREE.IcosahedronGeometry(R,6).toNonIndexed();
  const pos = geo.attributes.position, V = pos.count;
  const biome = new Uint8Array(V), bh = new Float32Array(V), toxic = new Float32Array(V);
  const nd = new THREE.Vector3();
  for(let i=0;i<V;i++){
    nd.set(pos.getX(i),pos.getY(i),pos.getZ(i)).normalize();
    const c = classify(nd);
    biome[i]=c.b; bh[i]=c.h;
    toxic[i] = (c.b>=2 && c.b<=4) ? Math.max(0, fbm(nd.x*5+30,nd.y*5,nd.z*5,3)) : 0;
    const lift = liftAt(c.h, nd);   // 육지 융기 + 대학 고원
    pos.setXYZ(i, pos.getX(i)*lift, pos.getY(i)*lift, pos.getZ(i)*lift);
  }
  geo.computeVertexNormals();
  const colors = new Float32Array(V*3);
  geo.setAttribute('color', new THREE.BufferAttribute(colors,3));
  const earthMat = new THREE.MeshStandardMaterial({vertexColors:true, flatShading:true, roughness:0.92, metalness:0.0});
  scene.add(earthGroup);
  const earth = new THREE.Mesh(geo, earthMat); earthGroup.add(earth);

  // ---- biome × 4stage 컬러 테이블 ----
  const HX = h=>new THREE.Color(h);
  //               0멸망      33사막     66정상     100청정
  const TAB = {
    0:[HX(0x35492a),HX(0x3e4a36),HX(0x123f63),HX(0x0c5285)], // deep ocean: 썩은녹→짙은 네이비블루
    1:[HX(0x42603a),HX(0x4e6042),HX(0x1c6b8e),HX(0x2090b4)], // shallow:   썩은녹→밝은 청록
    2:[HX(0x564c34),HX(0xa89868),HX(0xb8ad84),HX(0xb2a67c)], // beach
