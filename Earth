  }
  function enterCampus(idx){
    activeCampusIdx=idx; DEPARTMENTS=CAMPUSES[idx].departments; selIdx=0;
    centralScale=0.78+ratioOf(DEPARTMENTS[0])*0.4;
    earthGroup.position.set(0,0,0); earthGroup.scale.setScalar(centralScale); setEarthOpacity(1);
