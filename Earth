  },{passive:false});
  // 터치: 1손가락 회전 / 2손가락 핀치 줌
  let pinch=0;
  cv.addEventListener('touchstart',e=>{
    if(e.touches.length>=2){ const dx=e.touches[0].clientX-e.touches[1].clientX, dy=e.touches[0].clientY-e.touches[1].clientY; pinch=Math.hypot(dx,dy); }
    else dn(e.touches[0].clientX,e.touches[0].clientY);
  },{passive:true});
  addEventListener('touchmove',e=>{
    if(e.touches.length>=2){ const dx=e.touches[0].clientX-e.touches[1].clientX, dy=e.touches[0].clientY-e.touches[1].clientY; const d=Math.hypot(dx,dy);
      camDist=Math.max(camMin,Math.min(camMax,camDist+(pinch-d)*0.02)); pinch=d; updateCam(); }
    else if(drag) mv(e.touches[0].clientX,e.touches[0].clientY);
  },{passive:true});
  addEventListener('touchend',e=>{const t=e.changedTouches&&e.changedTouches[0];up(t?t.clientX:downX,t?t.clientY:downY);});

  // loop
  let smk=0;
  function animate(){
    requestAnimationFrame(animate);
    if(Math.abs(target-current)>0.05){current+=(target-current)*0.12;apply(current);}
    if(auto)rotY+=0.0015; else { if(!drag){vY*=0.93;vX*=0.93;rotY+=vY;rotX=Math.max(-0.9,Math.min(0.9,rotX+vX));} }
    earthGroup.rotation.y=rotY;earthGroup.rotation.x=rotX;
    // 학과 맞교환 + 디테일 크로스페이드 (이동하며 무거움↔가벼움 자연 전환)
    if(trans.active){
      const T=trans;
      T.t+=0.016/T.dur; const u=Math.min(T.t,1), e=u*u*(3-2*u);
      // 두 경로는 중앙↔클릭, e=0.5에서 정확히 교차
      _p1.lerpVectors(ORIGIN, T.clicked, e);   // 나가는 경로 (중앙→클릭)
      _p2.lerpVectors(T.clicked, ORIGIN, e);   // 들어오는 경로 (클릭→중앙)
      const outVis=2*T.centralOld+(T.outRad-2*T.centralOld)*e;  // 시각 반지름: 지구→bg
      const inVis =T.inRad+(2*T.centralNew-T.inRad)*e;          //            bg→지구
      // 가벼운 구체들
      T.outEntry.group.position.copy(_p1); T.outEntry.group.scale.setScalar(outVis/T.outRad);
      T.inEntry.group.position.copy(_p2);  T.inEntry.group.scale.setScalar(inVis/T.inRad);
      // 크로스페이드: 전반=나가는 행성(지구→구), 후반=들어오는 행성(구→지구)
      if(e<0.5){
        T.outEntry.mesh.material.opacity=e/0.5;       // 구 0→1
        T.inEntry.mesh.material.opacity=1;
        earthGroup.position.copy(_p1); earthGroup.scale.setScalar(outVis/2);
        setEarthOpacity(1-e/0.5);                     // 지구 1→0
      } else {
        if(!T.repainted){ T.repainted=true; selIdx=T.newIdx; current=target=DEPARTMENTS[T.newIdx].score; apply(current); }
        T.outEntry.mesh.material.opacity=1;
        T.inEntry.mesh.material.opacity=1-(e-0.5)/0.5; // 구 1→0
        earthGroup.position.copy(_p2); earthGroup.scale.setScalar(inVis/2);
        setEarthOpacity((e-0.5)/0.5);                  // 지구 0→1
      }
      if(u>=1) finalizeSwap();
    } else {
      earthGroup.scale.setScalar(centralScale);
    }
    cloudGroup.rotation.y+=0.0006;
    smk+=0.016;
    for(const p of props){
      if(!p.mesh.visible)continue;
      if(p.type==='turbine'&&p.mesh._hub)p.mesh._hub.rotation.z+=0.035;
      if(p.type==='windmill'&&p.mesh._sail)p.mesh._sail.rotation.z+=0.016;
      if(p.type==='factory'&&p.mesh._smoke)p.mesh._smoke.forEach((s,i)=>s.position.y=s._b+Math.sin(smk+i)*0.012);
      if(p.type==='nuke'&&p.mesh._steam)p.mesh._steam.forEach((s,i)=>{s.position.y=s._b+Math.sin(smk*0.7+i)*0.02;s.rotation.y+=0.006;});
    }
    satOrbit.rotation.y+=0.002; moon.rotation.y+=0.0016;
    // 은하 뷰: 각 은하 나선 자전
    if(view==='galaxy'){ for(const g of galaxies){ g.userData.pts.rotation.y += g.userData.spin; } }
    // 흩어진 학과 행성 — 자전 + 살짝 떠다님
    for(const b of bgPlanets){ const u=b.group.userData; b.mesh.rotation.y+=u.spin; u.ph+=0.01; b.group.position.y=u.baseY+Math.sin(u.ph)*0.18; }
    // 회전초 — 육지에서만, 바다로 가면 작아지며 사라짐
    for(const t of tumbleweeds){
      _q.setFromAxisAngle(t.axis,t.speed); t.pivot.quaternion.premultiply(_q);
      const k=ramp(current,t.lo,t.hi);
      _cur.copy(t.tw.position).normalize().applyQuaternion(t.pivot.quaternion);
      t.fade += ((isLand(_cur)?1:0) - t.fade)*0.09;
      const s=t.base*k*t.fade; t.tw.visible=s>0.003;
      if(t.tw.visible){ t.tw.scale.setScalar(s); t.tw.rotation.x+=0.1; }
    }
    // 뼈다귀 — 바다에서만, 대륙으로 가면 작아지며 사라짐
    for(const b of bones){
      _q.setFromAxisAngle(b.axis,b.speed); b.pivot.quaternion.premultiply(_q);
      const k=ramp(current,b.lo,b.hi);
      _cur.copy(b.holder.position).normalize().applyQuaternion(b.pivot.quaternion);
      b.fade += ((isLand(_cur)?0:1) - b.fade)*0.09;
      const s=b.base*k*b.fade; b.bn.visible=s>0.003;
      if(b.bn.visible){ b.bn.scale.setScalar(s);
        b.ph+=0.022; b.bn.position.y=Math.sin(b.ph)*0.02; b.bn.rotation.y+=0.005; b.bn.rotation.z=Math.sin(b.ph*0.7)*0.2; }
    }
    // 고래 — 바다에서만, 대륙으로 가면 작아지며 사라짐
    for(const wh of whales){
      _q.setFromAxisAngle(wh.axis,wh.speed); wh.pivot.quaternion.premultiply(_q);
      const k=ramp(current,wh.lo,wh.hi);
      _cur.copy(wh.holder.position).normalize().applyQuaternion(wh.pivot.quaternion);
      wh.fade += ((isLand(_cur)?0:1) - wh.fade)*0.09;
      const s=wh.base*k*wh.fade; wh.wh.visible=s>0.003;
      if(wh.wh.visible){ wh.wh.scale.setScalar(s);
        wh.ph+=0.028; wh.wh.position.y=Math.sin(wh.ph)*0.012; wh.wh.rotation.z=Math.sin(wh.ph)*0.1;
        if(wh.wh._fluke)wh.wh._fluke.rotation.y=Math.sin(wh.ph*2)*0.4; }
    }
    renderer.render(scene,camera);
  }
  animate();
  addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});

  // 로더 숨김
  setTimeout(()=>document.getElementById('loader').classList.add('hide'),350);
  </script>
</body>
</html>
